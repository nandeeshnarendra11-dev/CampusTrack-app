# ==============================================================================
# CampusTrack - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your secrets via the Secrets Panel in AI Studio.
#
# 1. FIREBASE CONFIGURATION (For real-time cloud sync & FCM)
# ------------------------------------------------------------------------------
# In AI Studio, Firebase services can be integrated with these variables:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_APP_ID=1:1234567890:android:abcdef123456
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# 2. GOOGLE MAPS & LOCATION API (Optional: If using Google Maps SDK)
# ------------------------------------------------------------------------------
# The app includes a high-performance vector canvas transit engine and can also
# use Google Play Services FusedLocationProviderClient for device GPS.
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# 3. DEMO & SIMULATION CONFIGURATION
# ------------------------------------------------------------------------------
ENABLE_DEMO_SIMULATOR=true
DEFAULT_SIMULATION_SPEED_MULTIPLIER=1.0
